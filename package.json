{
  "name": "budget-app",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first household budget and freedom-capital simulator, running on the GSSK kernel in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host",
    "start": "vite --host",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test \"tests/unit/**/*.test.ts\" \"tests/kernel/**/*.test.ts\"",
    "test:unit": "node --test \"tests/unit/**/*.test.ts\"",
    "test:kernel": "node --test \"tests/kernel/**/*.test.ts\"",
    "e2e": "playwright test",
    "hygiene": "node scripts/data-hygiene.mjs",
    "bundle-size": "node scripts/bundle-size.mjs",
    "gssk:verify": "node scripts/gssk-verify.mjs",
    "gssk:update": "sh scripts/gssk-update.sh",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.1.4"
  },
  "dependencies": {
    "comlink": "4.4.2"
  }
}
