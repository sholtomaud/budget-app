{
  "$comment": "Synthetic household persona (SPEC §7.2). Validated by src/lib/jsonschema.ts.",
  "title": "Persona",
  "type": "object",
  "required": ["name", "timezone", "start", "months", "accounts", "income"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "x-synthetic": { "type": "object" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "timezone": { "type": "string" },
    "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-01$" },
    "months": { "type": "integer", "minimum": 1, "maximum": 240 },
    "accounts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "role", "productCategory"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^SYN-[A-Z0-9-]+$" },
          "name": { "type": "string" },
          "role": {
            "enum": ["transaction", "savings", "offset", "credit", "loan", "investment", "super"]
          },
          "productCategory": { "type": "string" },
          "opening": { "$ref": "#/$defs/amount" },
          "interestPa": { "type": "number", "minimum": 0 },
          "limit": { "$ref": "#/$defs/amount" },
          "buffer": { "$ref": "#/$defs/amount" }
        }
      }
    },
    "income": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "amount", "every"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "payer": { "type": "string" },
          "category": { "type": "string" },
          "amount": { "$ref": "#/$defs/amount" },
          "every": { "$ref": "#/$defs/every" },
          "jitter": { "type": "number", "minimum": 0 },
          "rises": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["on", "pct"],
              "additionalProperties": false,
              "properties": { "on": { "$ref": "#/$defs/date" }, "pct": { "type": "number" } }
            }
          }
        }
      }
    },
    "recurring": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "every"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "payee": { "type": "string" },
          "amount": { "$ref": "#/$defs/amount" },
          "mean": { "$ref": "#/$defs/amount" },
          "every": { "$ref": "#/$defs/every" },
          "seasonality": { "enum": ["none", "winter_peak", "summer_peak"] },
          "cv": { "type": "number", "minimum": 0 },
          "via": { "enum": ["DIRECT_DEBIT", "PAYMENT", "TRANSFER_OUTGOING"] },
          "account": { "type": "string" },
          "mcc": { "type": "string" }
        }
      }
    },
    "variable": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category"],
        "additionalProperties": false,
        "properties": {
          "category": { "type": "string" },
          "weeklyMean": { "$ref": "#/$defs/amount" },
          "cv": { "type": "number", "minimum": 0 },
          "visitsPerWeek": { "type": "number", "exclusiveMinimum": 0 },
          "dailyProb": { "type": "number", "minimum": 0, "maximum": 1 },
          "amount": {
            "type": "object",
            "required": ["lognormal"],
            "properties": { "lognormal": { "type": "array", "items": { "type": "number" } } }
          },
          "merchants": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "mcc": { "type": "string" },
          "account": { "type": "string" }
        }
      }
    },
    "capex": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset", "cost"],
        "additionalProperties": false,
        "properties": {
          "asset": { "type": "string" },
          "category": { "type": "string" },
          "merchant": { "type": "string" },
          "mcc": { "type": "string" },
          "cost": {
            "oneOf": [
              { "$ref": "#/$defs/amount" },
              {
                "type": "object",
                "required": ["normal"],
                "properties": { "normal": { "type": "array", "items": { "type": "number" } } }
              }
            ]
          },
          "lifeYears": { "type": "number", "exclusiveMinimum": 0 },
          "shape": { "type": "number", "exclusiveMinimum": 0 },
          "lastBought": { "$ref": "#/$defs/date" },
          "wish": { "type": "boolean" },
          "buyProbPerYear": { "type": "number", "minimum": 0, "maximum": 1 },
          "every": { "const": "year" },
          "month": { "type": "array", "items": { "type": "integer", "minimum": 1, "maximum": 12 } },
          "account": { "type": "string" }
        }
      }
    },
    "investing": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["to", "amount", "every"],
        "additionalProperties": false,
        "properties": {
          "to": { "type": "string" },
          "amount": { "$ref": "#/$defs/amount" },
          "every": { "$ref": "#/$defs/every" },
          "kind": { "const": "investment" },
          "category": { "type": "string" }
        }
      }
    },
    "noise": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pendingThenPosted": { "type": "number", "minimum": 0, "maximum": 1 },
        "duplicatePages": { "type": "number", "minimum": 0, "maximum": 1 },
        "merchantNameVariants": { "type": "boolean" },
        "refunds": { "type": "number", "minimum": 0, "maximum": 1 },
        "fees": { "type": "boolean" },
        "missingTransactionId": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "pageSize": { "type": "integer", "minimum": 10, "maximum": 1000 }
  },
  "$defs": {
    "amount": { "type": "string", "pattern": "^-?\\d+(\\.\\d{1,2})?$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "every": { "enum": ["day", "week", "fortnight", "month", "quarter", "year"] }
  }
}
